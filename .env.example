# TraceLens OS — Environment Variables
# Copy to .env and fill in values

# Server mode (required for HTTP transport)
NODE_ENV=production

# Port for HTTP server
PORT=3000

# Logging level
LOG_LEVEL=info

# Database path (for persistent storage on NitroCloud)
# DATA_DIR=/data
# DB_PATH=/data/tracelens.db

# Optional: OAuth/JWT auth (future)
# OAUTH_REQUIRED=false
# JWT_SECRET=your-secret-here
