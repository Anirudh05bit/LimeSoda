{
  "name": "tracelens-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "node dist/index.js",
    "setup-db": "tsx src/database/tracelens-seed.ts",
    "reset-db": "rm -f tracelens.db && npm run setup-db",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "@nitrostack/core": "latest",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
